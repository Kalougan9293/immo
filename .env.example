NEXT_PUBLIC_SUPABASE_URL=https://TON_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TON_ANON_KEY

# URL publique de l’app (prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# fal.ai — Veo 3.1 Fast (prod DYNAMIC). Serveur uniquement — JAMAIS NEXT_PUBLIC_.
# Aussi utilisée par les scripts lab (Kling / Veo) dans scripts/
# https://fal.ai/dashboard/keys
# Alias accepté : FAL_API_KEY
# Render : Environment du Web Service, nom exact FAL_KEY, valeur = la clé seule
# (pas de quotes, pas de FAL_KEY=). Save déclenche un rebuild — un simple Restart
# ne suffit pas si la variable n’était pas là au `next build`.
FAL_KEY=
